---
interface Props {
  label: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { label, title, description, align = 'left' } = Astro.props;
---

<div class:list={['section-heading', { 'is-center': align === 'center' }]}>
  <div class="section-label"><span></span>{label}</div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</div>
